# Copy to .env (or set these in your hosting provider) to override defaults.
PORT=3000
# Optional. If left unset, you create the admin account on the first visit to /admin.
# ADMIN_USER=admin
# ADMIN_PASSWORD=choose-a-strong-password
# Folder where the SQLite database is stored. Must be on a persistent disk.
DATA_DIR=./data

# Optional: email settings as environment variables instead of the admin form (SMTP_HOST set = admin form locked).
# SMTP_HOST=mail.example.com
# SMTP_PORT=465
# SMTP_SECURITY=tls          # tls (465), starttls (587) or none (25)
# SMTP_USER=survey@example.com
# SMTP_PASSWORD=
# SMTP_FROM=survey@example.com
# SMTP_FROM_NAME=Sirix Survey
# SMTP_REPLY_TO=hr@example.com
# SMTP_TLS_VERIFY=1
# Optional: allow the "Restart the app" button in the admin (needs a service manager that restarts the process).
# ALLOW_RESTART=1
